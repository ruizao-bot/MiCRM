scale_shape_manual(values = c("1" = 16, "2" = 17, "3" = 15)) +
labs(x = "Facilitation", y = "CUE",color = "Community", shape = "Community") +
base_theme
p_feed
# 1) Facilitation vs CUE (ggplot) ------------------------------------------
feed_df <- make_long(df, prefix_x = "L_eff_sum", prefix_y = "CUE")
