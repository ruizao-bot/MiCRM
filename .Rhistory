# 读取数据
df <- read_csv('data/coal_resource.csv')
df$Dominant <- as.factor(df$Dominant)
df$Overlap <- as.factor(df$Overlap)
# 1. 相关性分析（AUC）
auc_results <- df %>%
group_by(Overlap) %>%
summarise(AUC = as.numeric(roc(Dominant, CUE3, levels = c('1','2'))$auc))
print(auc_results)
# 2. 交互作用分析（线性回归：Similarity ~ CUE3 * Overlap）
model_sim <- lm(Similarity ~ CUE3 * Overlap, data = df)
summary(model_sim)
# 3. 可视化（箱线图）
ggplot(df, aes(x = Dominant, y = CUE3, fill = Dominant)) +
geom_boxplot() +
facet_wrap(~Overlap) +
theme_bw() +
labs(title = 'CUE3 vs Dominant under different Overlap', y = 'CUE3')
View(df)
# 3. 可视化（箱线图）
ggplot(df, aes(x = Similarity, y = CUE3, fill = Dominant)) +
geom_boxplot() +
facet_wrap(~Overlap) +
theme_bw() +
labs(title = 'CUE3 vs Dominant under different Overlap', y = 'CUE3')
View(df)
