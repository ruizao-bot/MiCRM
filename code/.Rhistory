# logistic
library(minpack.lm)
library(dplyr)
fit_lines <- data.frame()
for (comm in c("Community 1", "Community 2", "Community 3")) {
dat <- df_surv[df_surv$Community == comm, ]
if (nrow(dat) > 0) {
model <- nlsLM(
Abundance ~ K / (1 + exp(-r * (CUE - x0))),
data = dat,
start = list(K = max(dat$Abundance), r = 5, x0 = median(dat$CUE)),
control = nls.control(maxiter = 200, warnOnly = TRUE)
)
cat("=== Summary for", comm, "===\n")
print(summary(model))
cat("\n")
cue_seq <- seq(min(dat$CUE), max(dat$CUE), length.out = 200)
pred <- data.frame(
CUE = cue_seq,
Abundance = predict(model, newdata = data.frame(CUE = cue_seq)),
Community = comm
)
fit_lines <- bind_rows(fit_lines, pred)
} else {
cat("No valid data for", comm, "\n\n")
}
}
ggplot(df_surv, aes(x = CUE, y = Abundance, color = Community)) +
geom_point(alpha = 0.7, size = 2) +
geom_line(data = fit_lines, aes(x = CUE, y = Abundance, color = Community), size = 1.2) +
theme_minimal() +
labs(
x = "CUE",
y = "Abundance (Abundance)",
color = "Community"
)
