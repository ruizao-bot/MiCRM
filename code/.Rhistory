round(min(df$CUE2), 3), ",", round(max(df$CUE2), 3), "]\n")
cat("Community 3 - Mean:", round(mean(df$CUE3), 3), "Range: [",
round(min(df$CUE3), 3), ",", round(max(df$CUE3), 3), "]\n")
# Outlier analysis for Facilitation vs CUE
cat("\n=== OUTLIER ANALYSIS: Facilitation vs CUE ===\n")
# Function to identify outliers using IQR method
identify_outliers <- function(x, y, labels = NULL) {
# Calculate quantiles and IQR for both x and y
x_q1 <- quantile(x, 0.25, na.rm = TRUE)
x_q3 <- quantile(x, 0.75, na.rm = TRUE)
x_iqr <- x_q3 - x_q1
y_q1 <- quantile(y, 0.25, na.rm = TRUE)
y_q3 <- quantile(y, 0.75, na.rm = TRUE)
y_iqr <- y_q3 - y_q1
# Define outlier boundaries (1.5 * IQR rule)
x_lower <- x_q1 - 1.5 * x_iqr
x_upper <- x_q3 + 1.5 * x_iqr
y_lower <- y_q1 - 1.5 * y_iqr
y_upper <- y_q3 + 1.5 * y_iqr
# Identify outliers
outliers <- which(x < x_lower | x > x_upper | y < y_lower | y > y_upper)
return(list(
indices = outliers,
x_bounds = c(x_lower, x_upper),
y_bounds = c(y_lower, y_upper),
x_values = x[outliers],
y_values = y[outliers]
))
}
# Analyze outliers for each community
communities <- list(
list(name = "Community 1", x = df$C_feed1, y = df$CUE1),
list(name = "Community 2", x = df$C_feed2, y = df$CUE2),
list(name = "Community 3", x = df$C_feed3, y = df$CUE3)
)
for (i in 1:3) {
comm <- communities[[i]]
outliers <- identify_outliers(comm$x, comm$y)
cat("\n", comm$name, ":\n")
if (length(outliers$indices) > 0) {
cat("  Found", length(outliers$indices), "outliers:\n")
for (j in outliers$indices) {
cat("    Point", j, ": b =", round(df$b[j], 3),
", Facilitation =", round(comm$x[j], 4),
", CUE =", round(comm$y[j], 4), "\n")
cat("      N_modules =", df$N_modules[j],
", Richness =", df[[paste0("Richness", i)]][j], "\n")
}
} else {
cat("  No outliers found\n")
}
}
# Richness statistics
cat("\nRichness Statistics:\n")
cat("Community 1 - Mean:", round(mean(df$Richness1), 1), "Range: [",
min(df$Richness1), ",", max(df$Richness1), "]\n")
cat("Community 2 - Mean:", round(mean(df$Richness2), 1), "Range: [",
min(df$Richness2), ",", max(df$Richness2), "]\n")
cat("Community 3 - Mean:", round(mean(df$Richness3), 1), "Range: [",
min(df$Richness3), ",", max(df$Richness3), "]\n")
# Correlation analysis
cat("\n=== CORRELATION ANALYSIS ===\n")
# CUE correlations with b
cor_cue1_b <- cor(df$b, df$CUE1)
# Quick outlier analysis: Find low CUE points in Facilitation 0.4-0.6 range
cat("\n=== OUTLIER ANALYSIS: Low CUE in Facilitation 0.4-0.6 ===\n")
# Combine all community data for analysis
all_facilitation <- c(df$C_feed1, df$C_feed2, df$C_feed3)
all_cue <- c(df$CUE1, df$CUE2, df$CUE3)
all_b <- rep(df$b, 3)
community_labels <- rep(c("Community 1", "Community 2", "Community 3"), each = nrow(df))
# Focus on facilitation range 0.4-0.6
range_mask <- all_facilitation >= 0.4 & all_facilitation <= 0.6
if (sum(range_mask) > 0) {
fac_in_range <- all_facilitation[range_mask]
cue_in_range <- all_cue[range_mask]
b_in_range <- all_b[range_mask]
comm_in_range <- community_labels[range_mask]
# Identify outliers as points with CUE < 0.61 in this range
outlier_mask <- cue_in_range < 0.65
if (sum(outlier_mask) > 0) {
cat("Found", sum(outlier_mask), "outliers with low CUE in facilitation range 0.4-0.6:\n\n")
outlier_b <- b_in_range[outlier_mask]
outlier_fac <- fac_in_range[outlier_mask]
outlier_cue <- cue_in_range[outlier_mask]
outlier_comm <- comm_in_range[outlier_mask]
for (i in 1:sum(outlier_mask)) {
cat("Outlier", i, ":", outlier_comm[i], "\n")
cat("  b =", round(outlier_b[i], 3), "\n")
cat("  Facilitation =", round(outlier_fac[i], 4), "\n")
cat("  CUE =", round(outlier_cue[i], 4), "\n")
cat("  --------\n")
}
cat("\nSUMMARY:\n")
cat("Outlier b values:", paste(round(unique(outlier_b), 3), collapse = ", "), "\n")
cat("Unique b values count:", length(unique(outlier_b)), "\n")
} else {
cat("No clear outliers found with CUE < 0.61 in facilitation range 0.4-0.6\n")
}
} else {
cat("No data points found in facilitation range 0.4-0.6\n")
}
library(readr)
# Try a few likely filenames and pick the first that exists
possible_files <- c(file.path('results','b_analysis_data_0.2.csv'),
file.path('results','b_analysis_data.csv'),
file.path('..','results','b_analysis_data_0.2.csv'),
file.path('..','results','b_analysis_data.csv'))
data_file <- NULL
for (f in possible_files) {
if (file.exists(f)) { data_file <- f; break }
}
if (is.null(data_file)) stop('Could not find b_analysis data CSV in results/')
